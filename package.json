{
  "name": "browser-audit-toolkit",
  "version": "1.0.0",
  "description": "State-of-the-art browser automation toolkit for testing, scraping, and privacy auditing of own sites",
  "main": "index.js",
  "scripts": {
    "start": "bash .claude/startup.sh",
    "startup": "bash .claude/startup.sh",
    "test:headless": "node 1-headless-chromium-tester.js https://example.com",
    "scrape:stealth": "node 2-puppeteer-stealth-scraper.js https://example.com scrape",
    "audit:performance": "node 2-puppeteer-stealth-scraper.js https://example.com audit",
    "audit:privacy": "node 3-privacy-hardened-browser.js https://example.com fingerprint",
    "audit:trackers": "node 3-privacy-hardened-browser.js https://example.com trackers",
    "audit:anti-detection": "node 4-advanced-anti-detection.js https://example.com",
    "bypass:cloudflare": "node 5-cloudflare-bypass.js https://example.com bypass",
    "detect:cloudflare": "node 5-cloudflare-bypass.js https://example.com detect",
    "bypass:direct-ip": "node 5-cloudflare-bypass.js https://example.com direct-ip",
    "test:all": "npm run test:headless && npm run audit:privacy && npm run audit:anti-detection",
    "verify": "test -f index.js && npm ls puppeteer && echo '✅ Toolkit verified'",
    "restore": "npm install && bash .claude/startup.sh"
  },
  "keywords": [
    "automation",
    "testing",
    "scraping",
    "privacy",
    "anti-detection",
    "audit",
    "puppeteer",
    "chromium"
  ],
  "author": "Brian",
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^25.12.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "puppeteer": true
  }
}
