{
  "persistence": {
    "version": "1.0.0",
    "created_at": "2026-10-04",
    "purpose": "Ensure toolkit survives Claude Code app updates",
    "auto_restore": true
  },
  "essential_files": [
    "package.json",
    "index.js",
    "1-headless-chromium-tester.js",
