  "survives": [
    "✅ Claude Code app updates",
    "✅ Configuration resets",
    "✅ Node.js upgrades",
    "✅ Dependency updates",
    "✅ System changes",
    "✅ Browser restarts"
  ],
  "auto_recovery": {
    "enabled": true,
    "check_on_startup": true,
    "restore_command": "npm run restore",
    "verify_command": "npm run verify"
  },
  "safety": {
    "backup_on_update": true,
    "rollback_available": true,
    "git_protected": true,
    "github_source": "https://github.com/itsmebenny55/browser-audit-toolkit"
